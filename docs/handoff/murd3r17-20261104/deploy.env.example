# Copy to /etc/sipim/deploy.env on the target; do not use sample values unchanged.
PUBLIC_IP=REPLACE_WITH_REACHABLE_IPV4
CONFIG_ROOT=/srv/sipim/runtime
DATA_ROOT=/srv/sipim/data
SERVER_PORT=8080
SIPIM_DB=/srv/sipim/data/sipim.db
ESL_ENABLED=true
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
