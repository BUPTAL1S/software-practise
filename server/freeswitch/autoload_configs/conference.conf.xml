<configuration name="conference.conf" description="Audio and Video Conference">
  <caller-controls>
    <group name="default">
      <control action="mute" digits="0"/>
      <control action="deaf mute" digits="*"/>
      <control action="energy up" digits="9"/>
      <control action="energy equ" digits="8"/>
      <control action="energy dn" digits="7"/>
      <control action="vol talk up" digits="3"/>
      <control action="vol talk zero" digits="2"/>
      <control action="vol talk dn" digits="1"/>
      <control action="hangup" digits="#"/>
    </group>
  </caller-controls>

  <profiles>
    <profile name="video-mcu-3x3">
      <param name="domain" value="lab"/>
      <param name="rate" value="16000"/>
      <param name="interval" value="20"/>
      <param name="energy-level" value="100"/>
      <param name="caller-controls" value="default"/>

      <!-- 最大容纳 8 人，第 9 人拒绝 (Busy) -->
      <param name="max-members" value="8"/>
      <param name="max-members-sound" value="conference/conf-locked.wav"/>

      <!-- 低负载九宫格；宽度低于部分 PJSIP OpenH264 构建的 1200 接收上限。 -->
      <param name="video-mode" value="mux"/>
      <param name="video-layout-name" value="3x3"/>
      <param name="video-canvas-size" value="960x540"/>
      <param name="video-fps" value="15"/>
      <param name="video-codec-bandwidth" value="1mb"/>
      <param name="video-no-video-avatar" value="/tmp/freeswitch-custom/avatars/default.png"/>

      <!-- 进出房音效与静音控制 -->
      <param name="enter-sound" value="tone_stream://%(200,0,500,600)"/>
      <param name="exit-sound" value="tone_stream://%(200,0,600,500)"/>
      <param name="alone-sound" value="tone_stream://%(100,50,400)"/>
    </profile>
  </profiles>
</configuration>
