<include>
  <context name="default">
    <!-- 阶段 5 会议室路由：把 room-* 的呼叫接入 video-mcu-3x3 会议室 -->
    <extension name="mcu_rooms">
      <condition field="destination_number" expression="^(room-.*)$">
        <action application="set" data="inherit_codec=true"/>
        <action application="set" data="codec_string=PCMU,PCMA,H264"/>
        <action application="answer"/>
        <action application="set" data="video_mute_png=/tmp/freeswitch-custom/avatars/${caller_id_number}.png"/>
        <action application="set" data="video_no_video_avatar_png=/tmp/freeswitch-custom/avatars/${caller_id_number}.png"/>
        <action application="conference" data="$1@video-mcu-3x3"/>
      </condition>
    </extension>
  </context>
</include>
